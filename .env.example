# PostgreSQL connection string (required)
# Local example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
#
# Railway: copy DATABASE_URL from the Postgres service → Variables / Connect.
# Use the public TCP URL when connecting from outside Railway (not *.railway.internal).
# Never commit a real Railway URL — put it only in local .env or the Railway service vars.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# LOCAL / DEV ONLY — unlocks POST /api/auctions and the /aukce/nova form without login.
# Do NOT set this in production or shared environments (anyone could create auctions).
# Leave unset/false until real auth (Google SSO later).
# ENABLE_UNAUTHENTICATED_AUCTION_CREATION="true"
