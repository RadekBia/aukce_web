# PostgreSQL connection string (required)
# Local example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# --- Local create-auction unlock (server-side only; not NEXT_PUBLIC_) ---
# Read by Server Components + API routes via src/lib/flags.ts.
# - "true"  → form + POST /api/auctions ON
# - "false" → forced OFF (even in development)
# - unset   → ON automatically when NODE_ENV=development; OFF in production
#
# On your machine: copy this into .env, then restart `npm run dev`.
# Use the PR #1 branch — older main still shows the permanent gated page.
# Never set true in production / shared hosting.
ENABLE_UNAUTHENTICATED_AUCTION_CREATION="true"
