# === Database (Postgres / Neon) ===
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# === Create without login (temporary until Google SSO) ===
# Default in code: ON until SSO (see src/lib/flags.ts).
# Set "false" to lock create early without deploying auth.
# ENABLE_UNAUTHENTICATED_AUCTION_CREATION="false"

# === Vercel Blob (optional photo upload) ===
# On Vercel: Storage → Blob → connect to this project injects BLOB_READ_WRITE_TOKEN.
# Locally you can paste a read-write token if you have one; otherwise use image URL field.
# BLOB_READ_WRITE_TOKEN=""
