# === Database (Postgres / Neon) ===
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# === Create without login (temporary until Google SSO) ===
# Default in code: ON until SSO (see src/lib/flags.ts).
# Set "false" to lock create early without deploying auth.
# ENABLE_UNAUTHENTICATED_AUCTION_CREATION="false"

# === Vercel Blob (photo attachments on /aukce/nova) ===
# Dashboard: Project → Storage → Blob → Create / Connect to Project
# → injects BLOB_READ_WRITE_TOKEN → Redeploy. Without it, file upload returns Czech 503;
# URL fallback on the form still works.
# BLOB_READ_WRITE_TOKEN=""

# === Admin delete (/sprava) until Google SSO ===
# Set a strong secret in Vercel → Settings → Environment Variables (Production).
# Open https://<host>/sprava and sign in with that same value. Unset = delete disabled (403).
# Never commit the real secret.
# ADMIN_SECRET=""
