# === Database (Postgres / Neon) ===
#
# Local Postgres — both can be the same:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
#   DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
#
# Neon (Vercel / production):
#   DATABASE_URL  = Neon "pooled" connection string (Prisma + PgBouncer; often host has -pooler)
#                   append ?sslmode=require if missing; Prisma often wants &pgbouncer=true on pooled URLs
#   DIRECT_URL    = Neon "direct" connection string (no pooler) — used by prisma migrate
#
# Never commit real URLs. Paste them into local .env and into Vercel Project → Settings → Environment Variables.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# === Local create-auction unlock (server-side only; not NEXT_PUBLIC_) ===
# See src/lib/flags.ts
# - "true"  → form + POST /api/auctions ON
# - "false" → forced OFF
# - unset   → ON in development; OFF in production
#
# Do NOT set this to true on Vercel Production.
ENABLE_UNAUTHENTICATED_AUCTION_CREATION="true"
