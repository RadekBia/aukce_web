# === Database (Postgres / Neon) ===
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/aukce_web?schema=public"

# Create without login is ON by default (see src/lib/flags.ts).
# Set "false" to lock create.
# ENABLE_UNAUTHENTICATED_AUCTION_CREATION="false"

# Photo uploads from /aukce/nova are stored as bytea in Neon (AuctionImage).
# Served at GET /api/images/[id]. No Vercel Blob / BLOB_READ_WRITE_TOKEN needed.

# === Admin (/sprava) ===
# Set a strong secret in Vercel → Settings → Environment Variables (Production).
# Open https://<host>/sprava and sign in with that same value. Unset = admin off.
# Never commit the real secret. Do not rotate Neon credentials here.
# ADMIN_SECRET=""
