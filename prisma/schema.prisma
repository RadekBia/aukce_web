generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: use the pooled connection string here (often includes -pooler host / pgbouncer).
  url       = env("DATABASE_URL")
  // Neon: use the direct (non-pooled) URL for migrations. Locally, set equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum AuctionStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

model Auction {
  id            String        @id @default(cuid())
  title         String        @db.VarChar(120)
  description   String        @db.Text
  category      String        @db.VarChar(60)
  condition     String        @db.VarChar(40)
  imageUrl      String?       @db.Text
  /// Extra / all gallery URLs (first also mirrored to imageUrl for cards).
  imageUrls     String[]      @default([])
  startingPrice Int
  currentPrice  Int
  status        AuctionStatus @default(ACTIVE)
  startsAt      DateTime      @default(now())
  endsAt        DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bids          Bid[]

  @@index([status, endsAt])
  @@index([category])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Int
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, amount])
}
