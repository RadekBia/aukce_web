generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: use the pooled connection string here (often includes -pooler host / pgbouncer).
  url       = env("DATABASE_URL")
  // Neon: use the direct (non-pooled) URL for migrations. Locally, set equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum AuctionStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

model Auction {
  id              String         @id @default(cuid())
  title           String         @db.VarChar(120)
  description     String         @db.Text
  category        String         @db.VarChar(60)
  condition       String         @db.VarChar(40)
  /// Person listing the auction (not a bidder).
  sellerFirstName String         @db.VarChar(40)
  sellerLastName  String         @db.VarChar(40)
  /// Admin winner override; both null/empty → highest bidder (or none).
  winnerFirstName String?        @db.VarChar(40)
  winnerLastName  String?        @db.VarChar(40)
  imageUrl        String?        @db.Text
  /// Legacy / external URL gallery (pasted https links). DB-backed photos use `images`.
  imageUrls       String[]       @default([])
  startingPrice   Int
  currentPrice    Int
  status          AuctionStatus  @default(ACTIVE)
  startsAt        DateTime       @default(now())
  endsAt          DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bids            Bid[]
  images          AuctionImage[]

  @@index([status, endsAt])
  @@index([category])
}

model AuctionImage {
  id        String   @id @default(cuid())
  auctionId String?
  mimeType  String   @db.VarChar(64)
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  auction   Auction? @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, sortOrder])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  bidderId  String
  amount    Int
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, amount])
}
